APP_ENV=prod
DATABASE_URL=sqlite:////data/analysis.db
NEWS_CLAWS_IMAGE=ghcr.io/shureeee/news_claws
NEWS_CLAWS_IMAGE_TAG=replace-with-immutable-git-sha
ADMIN_TOKEN=replace-with-at-least-32-random-characters
DOMAIN=news.example.com
ALLOWED_HOSTS=news.example.com,127.0.0.1,localhost
BASIC_AUTH_USER=newsadmin
BASIC_AUTH_HASH='replace-with-caddy-bcrypt-hash'
TRENDRADAR_MCP_URL=http://trendradar-mcp:3333/mcp
TRENDRADAR_ENABLED=false
SEARCH_PROVIDER=disabled
LLM_PROVIDER=deterministic
LLM_MODEL=rules-v1
DAILY_LLM_BUDGET=5.00
DATA_RETENTION_DAYS=365
SEED_DEMO=false
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_MAX_ITEMS=20
OUTBOUND_USER_AGENT=NewsClaws/0.1 (contact: ops@your-domain.example)
NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFICATION_BATCH_SIZE=100
